{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/*.sops.yaml)",
      "Read(**/secrets/bootstrap.yaml)",
      "Read(**/*.env)",
      "Read(**/.secrets.env)",
      "Read(**/kubeconfig*)",
      "Read(**/talosconfig*)",
      "Bash(sops -d:*)",
      "Bash(sops --decrypt:*)",
      "Bash(sops decrypt:*)",
      "Bash(just sops-view:*)",
      "Bash(just sops-decrypt:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(just core:*)",
      "Bash(pulumi:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl drain:*)",
      "Bash(talosctl reboot:*)",
      "Bash(talosctl upgrade:*)",
      "Bash(talosctl apply-config:*)",
      "Bash(talosctl reset:*)"
    ],
    "allow": [
      "Bash(just check)",
      "Bash(just lint:*)",
      "Bash(just fmt)",
      "Bash(just test)",
      "Bash(just synth)",
      "Bash(just docs-check)",
      "Bash(golangci-lint:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(talosctl get:*)",
      "Bash(talosctl dmesg:*)",
      "Bash(talosctl health:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-fmt.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
